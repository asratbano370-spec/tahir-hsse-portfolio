    .tiktok { background-color: #000000; }
    .telegram { background-color: #229ed9; }
    .x-twitter { background-color: #14171a; }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 0.8rem;
      color: #64748b;
    }
  </style>
</head>
