    :root {
      --primary-dark: #0d1b2a;
      --card-bg: #ffffff;
      --bg-color: #f4f6f9;
      --text-color: #334155;
      --brand-blue: #0284c7;
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      line-height: 1.5;
    }

    header {
      background: linear-gradient(180deg, #0b132b 0%, #1c2541 100%);
      color: white;
      padding: 30px 20px 40px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header-info {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .avatar-box {
      background: #00b4d8;
      color: white;
      font-weight: 700;
      font-size: 1.4rem;
      width: 55px;
      height: 55px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 10px rgba(0, 180, 216, 0.3);
    }

    .header-text h1 {
      font-size: 1.5rem;
      color: #38bdf8;
      font-weight: 700;
      line-height: 1.2;
    }

    .header-text p {
      font-size: 0.85rem;
      color: #94a3b8;
      margin-top: 4px;
    }

    .cv-btn {
      background: linear-gradient(135deg, #0284c7, #00b4d8);
      color: white;
      padding: 10px 16px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4);
      text-align: center;
    }

    .container {
      max-width: 700px;
      margin: -20px auto 30px auto;
      padding: 0 15px;
    }

    .card {
      background: var(--card-bg);
      padding: 24px 20px;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      margin-bottom: 20px;
    }

    .card-title {
      color: #0f172a;
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 15px;
      position: relative;
      padding-bottom: 8px;
    }

    .card-title::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 45px;
      height: 3px;
      background-color: var(--brand-blue);
      border-radius: 2px;
    }

    .about-text {
      font-size: 0.95rem;
      color: #475569;
      line-height: 1.6;
    }

    /* Experience Section Styling */
    .exp-item {
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #e2e8f0;
    }

    .exp-item:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .exp-company {
      font-size: 1rem;
      font-weight: 700;
      color: #0284c7;
    }

    .exp-position {
      font-size: 0.9rem;
      font-weight: 600;
      color: #1e293b;
      margin-top: 2px;
    }

    .exp-date {
      font-size: 0.8rem;
      color: #64748b;
      margin-bottom: 8px;
    }

    .exp-projects {
      font-size: 0.85rem;
      font-weight: 600;
      color: #334155;
      margin-bottom: 5px;
    }

    .exp-item ul {
      margin-left: 18px;
      font-size: 0.85rem;
      color: #475569;
    }

    .exp-item ul li {
      margin-bottom: 4px;
    }

    /* Contact Details */
    .contact-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 14px 16px;
      background: #f8fafc;
      border: 1px solid #f1f5f9;
      border-radius: 12px;
      text-decoration: none;
      color: #1e293b;
