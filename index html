    .contact-item i {
      font-size: 1.4rem;
    }

    .contact-item.phone i { color: #0284c7; }
    .contact-item.whatsapp i { color: #25d366; }

    .contact-info-text span {
      display: block;
      font-size: 0.75rem;
      color: #64748b;
      font-weight: 500;
    }

    .contact-info-text strong {
      display: block;
      font-size: 0.95rem;
